# Copy to docker/.env.data-plane and populate secrets before starting the overlay.
# Generate independent values with: openssl rand -hex 32
BETTER_AUTH_SECRET=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=
CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
OPENROUTER_API_KEY=
# Optional remote JEV System One credential; blank uses the local heuristic fallback.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
DEFAULT_SYSTEMONE_MODEL=jev-1.13.0
RAG_EMBEDDING_PROVIDER=auto
RAG_BGE_EMBEDDING_REVISION=80087bf0b7876bc948d3b5677706633f6c795fa2
RAG_OPENROUTER_BASE_URL=https://router.rissets.com/v1
RAG_OPENROUTER_EMBEDDING_MODEL=openrouter/text-embedding-3-small
RAG_OPENROUTER_RERANK_MODEL=openrouter/openrouter/cohere/rerank-v3.5
RAG_PDF_OCR_ENABLED=true
RAG_PDF_OCR_LANGS=eng+ind
RAG_PDF_OCR_MAX_PAGES=200
RAG_PDF_OCR_PAGE_TIMEOUT_MS=30000
DATASOURCE_WORKER_POLL_MS=2000
DATASOURCE_WORKER_MEMORY_LIMIT=2g
DATASOURCE_WORKER_CPUS=2

MINIO_CONSOLE_PORT=9001
PAPERCLIP_POSTGRES_HOST_PORT=15432
DATASOURCE_MINIO_S3_HOST_PORT=19000
DATASOURCE_CLICKHOUSE_HTTP_HOST_PORT=18123
DATASOURCE_REDIS_HOST_PORT=16379
DATASOURCE_CLICKHOUSE_MEMORY_LIMIT=4g
DATASOURCE_CLICKHOUSE_CPUS=2
DATASOURCE_MINIO_MEMORY_LIMIT=1g
DATASOURCE_MINIO_CPUS=1
DATASOURCE_REDIS_MAXMEMORY=256mb
DATASOURCE_REDIS_MEMORY_LIMIT=384m
DATASOURCE_REDIS_CPUS=0.5
DATASOURCE_QUERY_EMBEDDING_CACHE_TTL_SECONDS=3600
DATASOURCE_MAX_CSV_UPLOAD_BYTES=1073741824
DATASOURCE_MAX_FILE_UPLOAD_BYTES=104857600
DATASOURCE_MAX_UPLOAD_REQUEST_BYTES=1073741824
# ZIP extraction defaults to 1 GiB total expanded bytes, hard-capped at 2 GiB.
DATASOURCE_MAX_ZIP_EXPANDED_BYTES=1073741824
# Total original file bytes retained per company (default 100 GiB).
DATASOURCE_MAX_COMPANY_FILE_BYTES=107374182400
DATASOURCE_CLICKHOUSE_QUERY_MAX_EXECUTION_SECONDS=60
DATASOURCE_CLICKHOUSE_QUERY_MAX_MEMORY_BYTES=1073741824
DATASOURCE_CLICKHOUSE_QUERY_MAX_ROWS=10000000
DATASOURCE_CLICKHOUSE_QUERY_MAX_BYTES=1073741824
DATASOURCE_CLICKHOUSE_QUERY_MAX_RESULT_BYTES=67108864
DATASOURCE_CLICKHOUSE_INSERT_MAX_BATCH_ROWS=50000
