# Copy this to docker/.env.host-runtime, then set the same credentials used by
# docker/.env.data-plane and the base Compose BETTER_AUTH_SECRET.
NODE_ENV=development
PATH="/opt/homebrew/opt/node@24/bin:$HOME/.local/bin:/opt/homebrew/bin:$PATH"
PORT=3100
SERVE_UI=true
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_PUBLIC_URL=http://localhost:3100
BETTER_AUTH_SECRET="replace-with-the-base-compose-value"

PAPERCLIP_HOME="$HOME/.paperclip/datasource-host-runtime"
PAPERCLIP_INSTANCE_ID=default
PAPERCLIP_CONFIG="$HOME/.paperclip/datasource-host-runtime/instances/default/config.json"
PAPERCLIP_SECRETS_MASTER_KEY_FILE="$HOME/.paperclip/datasource-host-runtime/instances/default/secrets/master.key"

DATABASE_URL=postgres://paperclip:paperclip@127.0.0.1:15432/paperclip
CLICKHOUSE_URL=http://127.0.0.1:18123
CLICKHOUSE_USER=paperclip
CLICKHOUSE_PASSWORD="replace-with-docker-data-plane-value"
CLICKHOUSE_DATABASE=paperclip
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD="replace-with-docker-data-plane-value"

PAPERCLIP_STORAGE_S3_ENDPOINT=http://127.0.0.1:19000
PAPERCLIP_STORAGE_S3_BUCKET=paperclip-data
PAPERCLIP_STORAGE_S3_REGION=us-east-1
PAPERCLIP_STORAGE_S3_FORCE_PATH_STYLE=true
DATASOURCE_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:19000
DATASOURCE_OBJECT_STORAGE_BUCKET=paperclip-data
DATASOURCE_OBJECT_STORAGE_REGION=us-east-1
DATASOURCE_OBJECT_STORAGE_PREFIX=data-sources
DATASOURCE_OBJECT_STORAGE_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID="replace-with-MINIO_APP_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="replace-with-MINIO_APP_SECRET_KEY"
DATASOURCE_LOCAL_UPLOAD_DIRECTORY="$HOME/.paperclip/datasource-host-runtime/uploads"
DATASOURCE_EMBEDDED_WORKER_ENABLED=false
DATASOURCE_WORKER_HEALTH_PORT=3102
DATASOURCE_WORKER_POLL_MS=2000

RAG_EMBEDDING_PROVIDER=auto
RAG_BGE_EMBEDDING_URL=
RAG_BGE_RERANK_URL=
RAG_OPENROUTER_BASE_URL=https://router.rissets.com/v1
RAG_OPENROUTER_EMBEDDING_MODEL=openrouter/text-embedding-3-small
RAG_OPENROUTER_RERANK_MODEL=openrouter/openrouter/cohere/rerank-v3.5
OPENROUTER_API_KEY="replace-with-docker-data-plane-value"
